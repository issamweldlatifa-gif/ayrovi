{
  "name": "ayrovi",
  "version": "3.0.0",
  "description": "AYROVI — Universal Cross-Border Shopping & Visual AI Platform (React + Vite + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "build:client": "vite build",
    "build:server": "node -e 'require(\"esbuild\").buildSync({entryPoints:[\"src/server.ts\"],bundle:true,platform:\"node\",target:\"node20\",outfile:\"dist/server.js\",external:[\"better-sqlite3\",\"jsdom\",\"express\",\"cors\",\"uuid\",\"dotenv\",\"puppeteer\",\"puppeteer-extra\",\"puppeteer-extra-plugin-stealth\",\"tesseract.js\",\"multer\"]})'",
    "build": "npm run build:client && npm run build:server",
    "test": "vitest run"
  },
  "keywords": [
    "ayrovi",
    "e-commerce",
    "react",
    "vite",
    "proxy-shopping",
    "vision-ocr",
    "screenshot-scraper",
    "tunisia"
  ],
  "author": "AYROVI Team",
  "license": "ISC",
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "better-sqlite3": "^11.10.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "esbuild": "^0.20.2",
    "express": "^4.22.2",
    "jsdom": "^24.1.3",
    "lucide-react": "^1.31.0",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.9.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "supertest": "^6.3.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
